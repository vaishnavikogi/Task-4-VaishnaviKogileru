PORT=3000

# Leave DATABASE_URL empty to run instantly with the embedded demo database (nothing to install).
# To use your own PostgreSQL server (local, Supabase, Neon ...), put its connection string here:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/focusflow
DATABASE_URL=

# Set to true for cloud databases such as Supabase or Neon (they require SSL)
DATABASE_SSL=false

# Frontend addresses allowed to call this API from a browser (comma separated)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
